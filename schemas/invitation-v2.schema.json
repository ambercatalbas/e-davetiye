{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://e-davetiye.app/schemas/invitation-v2.schema.json",
  "title": "E-Davetiye Invitation v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "ownerId", "status", "defaultLocale", "title", "theme", "events", "blocks", "createdAt", "updatedAt"],
  "properties": {
    "schemaVersion": {"const": 2},
    "id": {"type": "string", "minLength": 8, "maxLength": 64, "pattern": "^[A-Za-z0-9_-]+$"},
    "ownerId": {"type": "string", "minLength": 1, "maxLength": 128},
    "status": {"enum": ["draft", "published", "archived", "cancelled"]},
    "slug": {"type": ["string", "null"], "minLength": 3, "maxLength": 64, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "defaultLocale": {"type": "string", "pattern": "^[a-z]{2}(?:-[A-Z]{2})?$"},
    "supportedLocales": {"type": "array", "items": {"type": "string", "pattern": "^[a-z]{2}(?:-[A-Z]{2})?$"}, "uniqueItems": true},
    "title": {"$ref": "#/$defs/localizedText"},
    "templateId": {"type": ["string", "null"], "maxLength": 80},
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 40},
        "colorMode": {"enum": ["system", "light", "dark"]},
        "overrides": {"type": "object", "additionalProperties": {"type": ["string", "number", "boolean"]}}
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {"$ref": "#/$defs/event"}
    },
    "blocks": {
      "type": "array",
      "maxItems": 80,
      "items": {"$ref": "#/$defs/block"}
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "public": {"type": "boolean"},
        "allowRsvp": {"type": "boolean"},
        "allowGuestbook": {"type": "boolean"},
        "allowGuestUploads": {"type": "boolean"},
        "rsvpDeadline": {"type": ["string", "null"], "format": "date-time"},
        "guestCapacity": {"type": ["integer", "null"], "minimum": 1, "maximum": 100000},
        "showBranding": {"type": "boolean"}
      }
    },
    "plan": {"enum": ["free", "premium", "pro"]},
    "publishedAt": {"type": ["string", "null"], "format": "date-time"},
    "createdAt": {"type": "string", "format": "date-time"},
    "updatedAt": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "localizedText": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string", "maxLength": 5000},
      "propertyNames": {"pattern": "^[a-z]{2}(?:-[A-Z]{2})?$"}
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "title", "startsAt", "timezone"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 64},
        "type": {"enum": ["ceremony", "reception", "kina", "nikah", "dugun", "mevlut", "sunnet", "party", "meeting", "other"]},
        "title": {"$ref": "#/$defs/localizedText"},
        "description": {"$ref": "#/$defs/localizedText"},
        "startsAt": {"type": "string", "format": "date-time"},
        "endsAt": {"type": ["string", "null"], "format": "date-time"},
        "timezone": {"type": "string", "minLength": 1, "maxLength": 64},
        "venue": {"$ref": "#/$defs/venue"},
        "dressCode": {"$ref": "#/$defs/localizedText"}
      }
    },
    "venue": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "maxLength": 200},
        "address": {"type": "string", "maxLength": 500},
        "latitude": {"type": "number", "minimum": -90, "maximum": 90},
        "longitude": {"type": "number", "minimum": -180, "maximum": 180},
        "googlePlaceId": {"type": ["string", "null"], "maxLength": 256},
        "mapsUrl": {"type": ["string", "null"], "format": "uri"}
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "enabled", "order", "data"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 64},
        "type": {"enum": ["cover", "hero", "text", "details", "countdown", "timeline", "map", "gallery", "music", "menu", "gift", "rsvp", "guestbook", "livestream", "signature", "seal", "notes"]},
        "enabled": {"type": "boolean"},
        "order": {"type": "integer", "minimum": 0, "maximum": 1000},
        "visibility": {"enum": ["public", "invited", "attending", "host"]},
        "locales": {"type": "object", "additionalProperties": {"type": "object"}},
        "data": {"type": "object"}
      }
    }
  }
}
