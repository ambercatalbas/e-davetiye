rules_version = '2';

// Davetiye uygulaması — Firestore güvenlik kuralları
// Dağıtım: firebase deploy --only firestore:rules
//
// Model:
//   invitations/{id}                 -> davetiye (sahibi düzenler, herkes id ile okur)
//   invitations/{id}/rsvps/{rid}     -> LCV yanıtları (davetli yazar, yalnız sahip okur)
//   invitations/{id}/guestbook/{gid} -> dilek defteri (davetli yazar, herkes okur, sahip siler)
//   slugs/{slug}                     -> özel kısa link -> davetiye kimliği

service cloud.firestore {
  match /databases/{database}/documents {

    match /invitations/{inviteId} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if request.auth != null
                    && resource.data.ownerUid == request.auth.uid;

      match /rsvps/{rsvpId} {
        allow create: if request.auth != null
          && request.resource.data.keys().hasOnly(['ad', 'durum', 'kisiSayisi', 'not', 'consentVersion', 'consentGranted', 'privacyNoticeVersion', 'createdAt', 'konukAnahtari'])
          && request.resource.data.ad is string
          && request.resource.data.ad.size() > 0
          && request.resource.data.ad.size() <= 80
          && request.resource.data.durum in ['geliyorum', 'gelemiyorum']
          && request.resource.data.kisiSayisi is int
          && request.resource.data.kisiSayisi >= 0
          && request.resource.data.kisiSayisi <= 20
          && request.resource.data.not is string
          && request.resource.data.not.size() <= 300
          && (!('konukAnahtari' in request.resource.data)
              || (request.resource.data.konukAnahtari is string && request.resource.data.konukAnahtari.size() <= 80))
          && request.resource.data.consentGranted == true
          && request.resource.data.consentVersion == 'lcv-tr-2026-08-06-v1'
          && request.resource.data.privacyNoticeVersion == 'privacy-2026-08-06-v1'
          && request.resource.data.createdAt == request.time;

        allow read: if request.auth != null
          && get(/databases/$(database)/documents/invitations/$(inviteId)).data.ownerUid == request.auth.uid;

        allow update, delete: if false;
      }

      // Dilek defteri: davetli (anonim dahil) mesaj bırakır; herkes okur; sahip siler (moderasyon).
      match /guestbook/{gid} {
        allow read: if true;
        allow create: if request.auth != null
          && request.resource.data.keys().hasOnly(['ad', 'mesaj', 'createdAt'])
          && request.resource.data.ad is string
          && request.resource.data.ad.size() > 0
          && request.resource.data.ad.size() <= 60
          && request.resource.data.mesaj is string
          && request.resource.data.mesaj.size() > 0
          && request.resource.data.mesaj.size() <= 500
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if request.auth != null
          && get(/databases/$(database)/documents/invitations/$(inviteId)).data.ownerUid == request.auth.uid;
      }
    }

    // Kullanıcı hesabı: kişinin kendi davetiye dizini (cihazlar arası "Davetiyelerim").
    // Yalnızca sahibi kendi alanını okur/yazar/listeler.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Özel kısa link: slug -> inviteId. Herkes çözebilir; yalnızca sahip oluşturur (benzersiz).
    match /slugs/{slug} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['inviteId', 'ownerUid', 'createdAt'])
        && request.resource.data.inviteId is string
        && request.resource.data.inviteId.size() > 0;
      allow update, delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }
  }
}
