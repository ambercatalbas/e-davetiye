rules_version = '2';

// Davetiye görselleri — Firebase Storage kuralları
// Dağıtım: firebase deploy --only storage
//
//   uploads/{uid}/{dosya}   -> davetiye görselleri (sahibi yazar/siler, herkes okur)
//   albums/{inviteId}/{...}  -> etkinlik sonrası misafir albümü (davetli yükler, herkes görür)

service firebase.storage {
  match /b/{bucket}/o {

    match /uploads/{uid}/{dosya=**} {
      allow read: if true;
      // Görsel (<8MB) veya ses (<15MB) — tip ve boyut sunucuda doğrulanır.
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && (
                     (request.resource.contentType.matches('image/.*') && request.resource.size < 8 * 1024 * 1024)
                     || (request.resource.contentType.matches('audio/.*') && request.resource.size < 15 * 1024 * 1024)
                   );
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Misafir foto albümü: giriş yapmış (anonim dahil) davetli yükler; herkes görür.
    match /albums/{inviteId}/{dosya=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
